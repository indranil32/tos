{
  "realm": "demo",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "tos:admin"
      },
      {
        "name": "tos:planner"
      },
      {
        "name": "tos:operator"
      },
      {
        "name": "tos:gate"
      },
      {
        "name": "tos:billing"
      },
      {
        "name": "tos:edi"
      },
      {
        "name": "tos:viewer"
      }
    ]
  },
  "clients": [
    {
      "clientId": "tos-web",
      "name": "TOS web app",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:5173/*"
      }
    },
    {
      "clientId": "tos-cli",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false
    },
    {
      "clientId": "tos-edi-partner",
      "description": "Example machine client for an EDI/API trading partner (OAuth client credentials)",
      "publicClient": false,
      "secret": "${TOS_EDI_PARTNER_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@demo.test",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "${TOS_DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "tos:admin"
      ]
    },
    {
      "username": "gate",
      "enabled": true,
      "email": "gate@demo.test",
      "emailVerified": true,
      "firstName": "Gate",
      "lastName": "Clerk",
      "credentials": [
        {
          "type": "password",
          "value": "${TOS_DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "tos:gate",
        "tos:viewer"
      ]
    },
    {
      "username": "service-account-tos-edi-partner",
      "enabled": true,
      "serviceAccountClientId": "tos-edi-partner",
      "realmRoles": [
        "tos:edi"
      ]
    }
  ]
}
